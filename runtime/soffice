#!/usr/bin/env python3
"""Project-local LibreOffice launcher; never uses the desktop user profile."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile

runtime = Path(__file__).resolve().parent
root = runtime / "office"
program = root / "usr/lib/libreoffice/program"
if not (program / "soffice.bin").is_file():
    sys.exit("Local LibreOffice is missing; run setup_office.py first.")
env = os.environ.copy()
# UNO must decode the installation path correctly even under apt's C locale.
if env.get("LC_ALL", env.get("LANG", "C")) in {"C", "POSIX"}:
    env["LC_ALL"] = "C.UTF-8"
env["LD_LIBRARY_PATH"] = os.pathsep.join([
    str(program), str(root / "usr/lib/x86_64-linux-gnu"),
    *([env["LD_LIBRARY_PATH"]] if env.get("LD_LIBRARY_PATH") else []),
])
env["SAL_USE_VCLPLUGIN"] = "svp"
env["URE_BOOTSTRAP"] = (program / "fundamentalrc").as_uri()
args = sys.argv[1:]
with tempfile.TemporaryDirectory(prefix="format-hub-office-") as temporary:
    profile = Path(temporary)
    env["XDG_CACHE_HOME"] = str(profile / "cache")
    if not any(arg.startswith("-env:UserInstallation=") for arg in args):
        args.insert(0, "-env:UserInstallation=" + (profile / "profile").as_uri())
    args.insert(0, "-env:BRAND_BASE_DIR=" + program.parent.as_uri())
    try:
        # The upstream launcher handles the first-profile restart exit code 81.
        result = subprocess.run([str(program / "soffice"), *args], env=env)
    except KeyboardInterrupt:
        sys.exit(130)
    sys.exit(result.returncode if result.returncode >= 0 else 128 - result.returncode)
